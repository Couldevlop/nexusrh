{
  "name": "@nexusrhci/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ci-holidays":     { "types": "./dist/ci-holidays.d.ts",     "default": "./dist/ci-holidays.js" },
    "./crypto":          { "types": "./dist/crypto.d.ts",          "default": "./dist/crypto.js" },
    "./http-body-limit": { "types": "./dist/http-body-limit.d.ts", "default": "./dist/http-body-limit.js" },
