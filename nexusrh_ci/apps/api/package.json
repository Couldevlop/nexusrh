{
  "name": "@nexusrhci/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env src/index.ts",
    "kill-port": "node -e \"const {execSync}=require('child_process');try{const out=execSync('netstat -ano').toString();out.split('\\n').filter(l=>l.includes(':4001')&&l.includes('LISTENING')).forEach(l=>{const pid=l.trim().split(/\\s+/).pop();try{execSync('taskkill /F /PID '+pid);}catch(e){}});}catch(e){}console.log('port 4001 cleared')\"",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "db:seed-pme-test": "tsx --env-file=../../.env src/db/seed-pme-test.ts",
    "db:migrate-tenants": "tsx --env-file=../../.env src/db/migrate-tenants.ts",
    "db:migrate-tenants:dry-run": "tsx --env-file=../../.env src/db/migrate-tenants.ts --dry-run",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "admin:reset-passwords": "tsx --env-file=../../.env src/db/reset-admin-passwords.ts",
    "admin:reset-passwords:dry-run": "tsx --env-file=../../.env src/db/reset-admin-passwords.ts --dry-run",
    "admin:reset-passwords:health-check": "tsx --env-file=../../.env src/db/reset-admin-passwords.ts --health-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run src/services/golden",
    "payroll:fixtures:approve": "tsx src/services/golden/approve-fixture.ts",
    "rns:calibrate": "tsx src/scripts/rns-calibrate.ts",
    "demo:multi-filiales": "tsx --env-file=../../.env src/scripts/enable-multi-filiales-sotra.ts",
    "demo:syrse-groupe": "tsx --env-file=../../.env src/scripts/enable-syrse-groupe.ts"
  },
  "dependencies": {
    "@nexusrhci/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.24.3",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@elastic/elasticsearch": "^9.4.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/oauth2": "^8.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.8.4",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.3.2",
    "nodemailer": "^9.0.6",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "qrcode": "^1.5.4",
    "undici": "^7.29.0",
    "unpdf": "^1.6.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mjml": "^4.7.4",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}
